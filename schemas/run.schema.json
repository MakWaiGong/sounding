{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sounding/run.schema.json",
  "title": "Sounding resumable run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "citekey", "source_path", "source_sha256",
    "note_path", "note_sha256", "required_steps", "steps",
    "invalidations", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "citekey": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "note_path": {"type": ["string", "null"], "minLength": 1},
    "note_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "required_steps": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["pdf_prepared", "note_validated", "notion_written", "images_verified", "zotero_written"]}
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pdf_prepared": {"$ref": "#/$defs/step"},
        "note_validated": {"$ref": "#/$defs/step"},
        "notion_written": {"$ref": "#/$defs/step"},
        "images_verified": {"$ref": "#/$defs/step"},
        "zotero_written": {"$ref": "#/$defs/step"}
      }
    },
    "invalidations": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "at", "source_sha256", "note_sha256"],
      "properties": {
        "status": {"enum": ["done", "failed"]},
        "at": {"type": "string", "format": "date-time"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "note_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidence": {"type": "object"},
        "error": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "done"}}},
          "then": {"required": ["evidence"]},
          "else": {"required": ["error"]}
        }
      ]
    }
  }
}
